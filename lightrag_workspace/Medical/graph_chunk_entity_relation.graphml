      <data key="d4">7.0</data>
      <data key="d5">Differential analysis is part of the diagnostic process to identify abnormal cell types in CLL.</data>
      <data key="d6">procedural component, cell type differentiation</data>
      <data key="d7">chunk-717174ace5855cc823d51c46c9a70648</data>
    </edge>
    <edge source="Diagnostic Tools" target="Differential">
      <data key="d4">7.0</data>
      <data key="d5">Differential analysis is a diagnostic tool for identifying abnormal cell types in CLL.</data>
      <data key="d6">cell type differentiation, diagnostic tool</data>
      <data key="d7">chunk-717174ace5855cc823d51c46c9a70648</data>
    </edge>
    <edge source="Diagnostic Criteria" target="Differential">
      <data key="d4">8.0</data>

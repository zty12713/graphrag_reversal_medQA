      <data key="d4">18.0</data>
      <data key="d5">Radioactive Iodine (RAI) Therapy is often used after Total Thyroidectomy to destroy any remaining cancer cells in the body.</data>
      <data key="d6">cancer treatment, post-surgical therapy</data>
      <data key="d7">chunk-e74c94f9f2ff33172671e8742338c6d1</data>
    </edge>

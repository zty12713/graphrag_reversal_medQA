    </edge>
    <edge source="Ultrasound" target="Cancer">
      <data key="d4">16.0</data>
      <data key="d5">Ultrasound is used to detect small cancerous lesions in lymph nodes and guide biopsies, offering a non-invasive imaging option.</data>

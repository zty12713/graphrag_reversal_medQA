      <data key="d7">chunk-a18089523f6dcd63cfa5664dc1c01618</data>
    </edge>
    <edge source="Positron Emission Tomography (PET) Scan" target="Staging">
      <data key="d4">8.0</data>
      <data key="d5">PET scans detect metabolic activity, often combined with CT/MRI to identify cancer spread and refine staging.</data>
      <data key="d6">imaging, metastasis detection</data>

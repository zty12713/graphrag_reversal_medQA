      <data key="d4">1.0</data>
      <data key="d5">management-for</data>
      <data key="d6">Follow-up Care is part of the management for Thyroid Cancer patients.</data>
      <data key="d7">chunk-9d383e4798456aa46e381fd2b02f6f96</data>
    </edge>
    <edge source="Neck Ultrasound" target="Thyroid Cancer">
      <data key="d4">1.0</data>
      <data key="d5">monitoring-for</data>
      <data key="d6">Neck Ultrasound is used to monitor for Thyroid Cancer recurrence.</data>
      <data key="d7">chunk-9d383e4798456aa46e381fd2b02f6f96</data>
    </edge>
    <edge source="TSH Blood Test" target="Thyroid Cancer">
      <data key="d4">1.0</data>
      <data key="d5">monitoring-for</data>
      <data key="d6">TSH Blood Test is part of the follow-up care for Thyroid Cancer.</data>
      <data key="d7">chunk-9d383e4798456aa46e381fd2b02f6f96</data>
    </edge>

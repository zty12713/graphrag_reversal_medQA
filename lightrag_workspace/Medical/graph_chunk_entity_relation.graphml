    </edge>
    <edge source="Endorectal Ultrasound" target="Rectal Cancer">
      <data key="d4">7.0</data>
      <data key="d5">Endorectal ultrasound evaluates local cancer extent in the pelvis and guides biopsies of lymph nodes or surrounding tissues.</data>
      <data key="d6">local staging, biopsy guidance</data>
      <data key="d7">chunk-594536d6aaa61f8f1699ba50bf218a33</data>
    </edge>
    <edge source="Transabdominal Surgery" target="Rectal Cancer">
      <data key="d4">18.0</data>
      <data key="d5">Transabdominal Surgery is a recommended treatment for rectal cancer, particularly for tumors invading the muscle layer of the rectal wall.</data>
      <data key="d6">cancer treatment, surgical intervention</data>
      <data key="d7">chunk-37bca9f4d2ebaeed359c9b4eb7a0c1de</data>

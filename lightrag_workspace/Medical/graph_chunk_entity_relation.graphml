      <data key="d7">chunk-53e3a9418b1d7916e3c8717a397bbb58</data>
    </edge>
    <edge source="ALL" target="National Comprehensive Cancer Network® (NCCN®)">
      <data key="d4">9.0</data>
      <data key="d5">The NCCN provides guidelines and resources for managing ALL, including diagnostic and treatment protocols.</data>
      <data key="d6">guideline provision, cancer care</data>
      <data key="d7">chunk-c5bc83f5f4f3e29b7f0a6f4787c3ad83</data>
    </edge>

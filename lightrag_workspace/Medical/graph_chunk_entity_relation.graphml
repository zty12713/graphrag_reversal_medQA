      <data key="d7">chunk-ef6586b896c47b361bf4f6aabb4c35d5</data>
    </edge>
    <edge source="Airways" target="Bronchioli">
      <data key="d4">9.0</data>
      <data key="d5">Bronchioli are part of the airways, forming the small airways that lead to the alveoli.</data>
      <data key="d6">anatomical structure, respiratory system</data>
      <data key="d7">chunk-ef6586b896c47b361bf4f6aabb4c35d5</data>
    </edge>
    <edge source="Airways" target="Trachea">
      <data key="d4">9.0</data>
      <data key="d5">Trachea is part of the airways, connecting the throat to the lungs.</data>
      <data key="d6">anatomical structure, respiratory system</data>
      <data key="d7">chunk-ef6586b896c47b361bf4f6aabb4c35d5</data>
    </edge>

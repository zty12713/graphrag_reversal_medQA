    </edge>
    <edge source="Papillary Carcinoma" target="Surgery">
      <data key="d4">9.0</data>
      <data key="d5">Surgery is the primary treatment for papillary carcinoma, involving the removal of the thyroid gland or affected lobes.</data>
      <data key="d6">treatment, cancer management</data>

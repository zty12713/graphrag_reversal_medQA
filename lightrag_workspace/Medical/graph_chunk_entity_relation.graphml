    <edge source="Osteoporosis" target="Surgical Menopause">
      <data key="d4">9.0</data>
      <data key="d5">Surgical menopause contributes to osteoporosis risk by causing rapid estrogen decline, leading to bone density loss.</data>
      <data key="d6">hormonal imbalance, bone health</data>

    <edge source="Non-small cell lung cancer (NSCLC)" target="Lung Cancer">
      <data key="d4">8.0</data>
      <data key="d5">NSCLC is a major category of lung cancer, representing the most common form of the disease.</data>
      <data key="d6">cancer classification, medical taxonomy</data>

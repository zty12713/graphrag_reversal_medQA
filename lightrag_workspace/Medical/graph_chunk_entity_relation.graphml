      <data key="d7">chunk-d0f15711706bc171fed17a7fab91b4b6</data>
    </edge>
    <edge source="HIV Blood Test" target="Primary CNS Lymphoma">
      <data key="d4">18.0</data>
      <data key="d5">An HIV blood test is mandatory for all primary CNS lymphoma patients to identify HIV-related cases requiring specialized care.</data>

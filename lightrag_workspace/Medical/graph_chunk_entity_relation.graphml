    </edge>
    <edge source="Unresectable Cancers" target="Radiation Therapy">
      <data key="d4">14.0</data>
      <data key="d5">Radiation therapy is used alongside chemotherapy for unresectable cancers to shrink tumors and improve treatment outcomes.</data>

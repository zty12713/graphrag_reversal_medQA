    </edge>
    <edge source="Clinical Trials" target="Radiation Therapy">
      <data key="d4">16.0</data>
      <data key="d5">Radiation therapy is a treatment modality often studied in clinical trials to evaluate its efficacy and side effects in cancer patients.</data>

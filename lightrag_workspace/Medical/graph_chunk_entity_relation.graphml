      <data key="d6">medical expertise, treatment administration</data>
      <data key="d7">chunk-b0bad5ee25cb854c10bdbc9d33b54a1a</data>
    </edge>
    <edge source="Total Thyroidectomy" target="Papillary Thyroid Cancer">
      <data key="d4">18.0</data>
      <data key="d5">Total Thyroidectomy is a recommended treatment for Papillary Thyroid Cancer that has spread beyond the thyroid or is of high risk.</data>
      <data key="d6">cancer treatment, surgical intervention</data>
      <data key="d7">chunk-e74c94f9f2ff33172671e8742338c6d1</data>
    </edge>

      <data key="d7">chunk-dea00cf063e8831db4919330d94b1f2a</data>
    </edge>
    <edge source="Pharmacist" target="Medical Oncologist">
      <data key="d4">9.0</data>
      <data key="d5">The Pharmacist collaborates with the Medical Oncologist to ensure proper administration of chemotherapy and other medications for cancer treatment.</data>

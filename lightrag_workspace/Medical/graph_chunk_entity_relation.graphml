    </edge>
    <edge source="High Grade" target="Pathologist">
      <data key="d4">8.0</data>
      <data key="d5">The pathologist evaluates cancer cells to determine their grade, identifying high-grade tumors with rapid growth and higher metastatic potential.</data>

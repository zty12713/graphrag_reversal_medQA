      <data key="d7">chunk-bd06bc83e13e7562ce65d6eee1b6024f</data>
    </edge>
    <edge source="Cancer Treatment Options" target="Surgery">
      <data key="d4">16.0</data>
      <data key="d5">Surgery is a primary treatment option for early-stage cancers, involving the removal of tumors or affected tissues.</data>
      <data key="d6">localized intervention, curative approach</data>
      <data key="d7">chunk-8ec4d44b145ca896ff1216caa90ce5dd</data>
    </edge>
    <edge source="Early-Stage Cancer" target="Surgery">
      <data key="d4">18.0</data>
      <data key="d5">Surgery is a common treatment for early-stage cancer, aiming to remove the tumor and surrounding tissue to achieve a cure.</data>
      <data key="d6">curative intervention, localized removal</data>
      <data key="d7">chunk-8ec4d44b145ca896ff1216caa90ce5dd</data>
    </edge>
    <edge source="Exploratory Surgery" target="Surgery">
      <data key="d4">18.0</data>
      <data key="d5">Exploratory Surgery is a type of Surgical intervention used to assess cancer extent and guide treatment decisions.&lt;SEP&gt;Exploratory Surgery is a type of surgical intervention used to assess cancer extent and guide treatment decisions.</data>
      <data key="d6">diagnostic surgery, treatment planning</data>
      <data key="d7">chunk-b3ba7430f3a31330247f52afe7e9c68a</data>

    </edge>
    <edge source="Follicular Carcinoma" target="Surgery">
      <data key="d4">9.0</data>
      <data key="d5">Surgery is the primary treatment for follicular carcinoma, involving the removal of the thyroid gland or affected lobes.</data>
      <data key="d6">treatment, cancer management</data>
      <data key="d7">chunk-8a1130b0f6bbe935ceddbafc6ce2740f</data>
    </edge>
    <edge source="Oncocytic Carcinoma" target="Surgery">
      <data key="d4">8.0</data>
      <data key="d5">Surgery is the primary treatment for oncocytic carcinoma, involving the removal of the thyroid gland or affected lobes.</data>
      <data key="d6">treatment, cancer management</data>
      <data key="d7">chunk-8a1130b0f6bbe935ceddbafc6ce2740f</data>
    </edge>
    <edge source="Medullary Thyroid Cancer" target="Surgery">
      <data key="d4">8.0</data>
      <data key="d5">Surgery is the primary treatment for medullary thyroid cancer, often combined with genetic screening and hormone therapy.</data>
      <data key="d6">treatment, genetic factors</data>

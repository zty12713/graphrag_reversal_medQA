      <data key="d5">The differential identifies abnormal white blood cell types in CBC, aiding in CLL diagnosis.</data>
      <data key="d6">cell type analysis, diagnostic differentiation</data>
      <data key="d7">chunk-717174ace5855cc823d51c46c9a70648</data>
    </edge>

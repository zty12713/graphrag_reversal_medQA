    </edge>
    <edge source="Genetic Test" target="Genetic Counselor">
      <data key="d4">18.0</data>
      <data key="d5">Genetic Counselors assist patients in understanding and interpreting the results of genetic tests for hereditary cancer risks.</data>
      <data key="d6">genetic interpretation, hereditary risk</data>
      <data key="d7">chunk-789ec6c06f8c999ac21c89b085b3fdb7</data>
    </edge>
    <edge source="Hereditary Gene Testing" target="Genetic Counselor">
      <data key="d4">18.0</data>
      <data key="d5">Genetic counselors provide expert guidance on interpreting hereditary gene test results and managing cancer risk.</data>
      <data key="d6">genetic interpretation, risk management</data>
      <data key="d7">chunk-965e5a6bad03f2129a98be4373f99176</data>
    </edge>
    <edge source="Pathologic Examination" target="Fine-Needle Aspiration (FNA)">
      <data key="d4">18.0</data>

      <data key="d7">chunk-b3c0f6d26f2f58ca13201c1a90b0a180</data>
    </edge>
    <edge source="Biopsy" target="Ultrasound">
      <data key="d4">54.0</data>
      <data key="d5">Ultrasound guides the biopsy procedure by providing real-time imaging of the prostate for accurate needle placement.&lt;SEP&gt;Ultrasound is frequently used to guide biopsy procedures, allowing precise targeting of suspicious areas in the breast.&lt;SEP&gt;Ultrasound is often used to guide biopsy procedures, ensuring precise sample collection from suspected cancerous areas.</data>
      <data key="d6">imaging guidance, biopsy accuracy&lt;SEP&gt;procedural guidance, diagnostic accuracy</data>
      <data key="d7">chunk-9ad38c9dc069a8ff8df58c42f00eba23&lt;SEP&gt;chunk-7f9fe20fe42489996573eb1b436128b6&lt;SEP&gt;chunk-975e540ddee1810d43caf8df4adcf205</data>
    </edge>

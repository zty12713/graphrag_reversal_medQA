      <data key="d6">cancer staging, post-treatment monitoring</data>
      <data key="d7">chunk-c9383db20cd696688798a193862cb5cc</data>
    </edge>
    <edge source="Bladder Cancer" target="Stage 1">
      <data key="d4">8.0</data>

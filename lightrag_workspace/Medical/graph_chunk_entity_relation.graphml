      <data key="d4">1.0</data>
      <data key="d5">indicator-for</data>
      <data key="d6">Thyroglobulin levels are monitored to detect Thyroid Cancer recurrence.</data>
      <data key="d7">chunk-9d383e4798456aa46e381fd2b02f6f96</data>

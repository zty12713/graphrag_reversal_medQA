    </edge>
    <edge source="NCCN" target="Chronic Myeloid Leukemia (CML)">
      <data key="d4">16.0</data>
      <data key="d5">NCCN offers expert recommendations for follow-up exams and monitoring for patients with chronic myeloid leukemia, including imaging and physical exams.</data>
      <data key="d6">cancer care, treatment protocols</data>
      <data key="d7">chunk-8b66e38931f28ed6ac9b231faaf202fb</data>

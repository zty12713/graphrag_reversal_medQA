    <edge source="UV Radiation" target="Skin Cancer">
      <data key="d4">8.0</data>
      <data key="d5">UV Radiation is a major contributing factor to the development of Skin Cancer, including basal cell skin cancer, by damaging DNA in skin cells.</data>
      <data key="d6">causal relationship, carcinogenic exposure</data>
      <data key="d7">chunk-66dd071b6c2be50e36cee1a1c1bd3b33</data>
